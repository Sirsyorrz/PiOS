{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": false,
    // Sources run under Node's type stripping, which erases but never emits.
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "noEmit": true
  },
  // apps/web needs DOM lib and JSX, so it typechecks under its own config.
  "include": ["spikes/**/*.ts", "packages/**/*.ts"],
  // The Worker targets workerd and typechecks under packages/relay's config.
  "exclude": ["packages/relay/src/worker.ts"]
}
